// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  username    String
  password    String
  salt        String
  created_at  DateTime      @default(now())
  updated_at  DateTime      @default(now()) @updatedAt
  ProjectUser ProjectUser[]
  Tag         Tag[]
  TagMessage  TagMessage[]
  Project     Project[]
  Model       Model[]
}

model ProjectUser {
  id         Int      @id @default(autoincrement())
  project    Project  @relation(fields: [project_id], references: [id])
  project_id Int
  user       User     @relation(fields: [user_id], references: [id])
  is_admin   Boolean
  user_id    Int
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@unique([project_id, is_admin], name: "unique_admin_per_project")
}

model Project {
  id            Int           @id @default(autoincrement())
  name          String
  description   String?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @default(now()) @updatedAt
  Model         Model[]
  Tag           Tag[]
  ProjectUser   ProjectUser[]
  created_by    User          @relation(fields: [created_by_id], references: [id])
  created_by_id Int
  Status        Status[]
}

model Model {
  id            Int      @id @default(autoincrement())
  version       Int
  model_link    String
  name          String
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt
  project       Project  @relation(fields: [project_id], references: [id])
  project_id    Int
  created_by    User     @relation(fields: [created_by_id], references: [id])
  created_by_id Int
}

model Tag {
  id            Int          @id @default(autoincrement())
  title         String
  created_at    DateTime     @default(now())
  updated_at    DateTime     @default(now()) @updatedAt
  position_x    Float        @db.Real
  position_y    Float        @db.Real
  position_z    Float        @db.Real
  rotation_x    Float        @default(0) @db.Real
  rotation_y    Float        @default(0) @db.Real
  rotation_z    Float        @default(0) @db.Real
  scale_x       Float        @default(0.3) @db.Real
  scale_y       Float        @default(0.3) @db.Real
  scale_z       Float        @default(0.3) @db.Real
  TagMessage    TagMessage[]
  model         Project      @relation(fields: [project_id], references: [id])
  project_id    Int
  created_by    User         @relation(fields: [created_by_id], references: [id])
  created_by_id Int
  status_id     Int?
  status        Status?      @relation(fields: [status_id], references: [id], onDelete: SetNull)
}

model TagMessage {
  id            Int      @id @default(autoincrement())
  text          String
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt
  tag           Tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  tag_id        Int
  created_by    User     @relation(fields: [created_by_id], references: [id])
  created_by_id Int
}

model Status {
  id         Int      @id @default(autoincrement())
  title      String
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  color_r    Float    @db.Real
  color_g    Float    @db.Real
  color_b    Float    @db.Real
  project_id Int
  shape      Shape    @default(Cuboid)
  project    Project  @relation(fields: [project_id], references: [id])
  Tag        Tag[]

  @@unique([title, project_id], name: "unique_title_per_project")
}

enum Shape {
  Cuboid
  Tetrahedron
  Capsule3d
  Torus
  Cylinder
  Cone
  ConicalFrustum
  Sphere
}
