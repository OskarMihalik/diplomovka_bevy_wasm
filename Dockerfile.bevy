FROM rust:latest as builder
WORKDIR /app

# Install dependencies if necessary (often needed for rust/bevy builds on linux, even if compiling to wasm, sometimes macro dependencies require them)
RUN apt-get update && apt-get install -y pkg-config libudev-dev

# Install wasm32-unknown-unknown target
RUN rustup target add wasm32-unknown-unknown

# Install trunk
RUN cargo install trunk

# Copy the whole workspace
COPY . .

ENV SKIP_DB_BUILD=1

# Build the bevy app
WORKDIR /app/bevy_diplomovka
RUN trunk build --release --cargo-profile wasm-release
# Precompress for nginx `gzip_static`, the wasm shrinks to about a third
RUN find dist -type f \( -name '*.wasm' -o -name '*.js' -o -name '*.html' -o -name '*.css' \) -exec gzip -9 -k {} \;

# Serve stage
FROM nginx:alpine
COPY --from=builder /app/bevy_diplomovka/dist /usr/share/nginx/html
COPY bevy_diplomovka/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
